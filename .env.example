# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh
# di-commit (sudah ada di .gitignore).
#
# Membuat nilai acak:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Kunci penandatangan session Flask. Jika kosong, dibuat acak setiap
# aplikasi dijalankan (login hilang setelah restart).
SECRET_KEY=

# API key untuk POST /api/events. Jika kosong, API ingestion nonaktif.
SIEM_API_KEY=

# Password akun awal. Jika kosong, dibuat acak dan ditampilkan SATU KALI
# di console saat database pertama kali dibuat.
ADMIN_PASSWORD=
ANALYST_PASSWORD=

# Opsional
# FLASK_DEBUG=0
# HOST=127.0.0.1
# PORT=5000
# SESSION_COOKIE_SECURE=0
